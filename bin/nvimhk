#!/usr/bin/env bash
set -euo pipefail

help() {
    printf '\033[1;36mNVIMHK — Neovim hotkeys & generators\033[0m\n'
    printf 'Использование: nvimhk [опция]\n\n'
    printf '  %-16s %s\n' \
      --basic 'Основные команды' \
      --edit 'Редактирование' \
      --search 'Поиск и Telescope' \
      --csharp 'Roslyn и IntelliSense' \
      --window 'Буферы и окна' \
      --terminal 'Терминал' \
      --tree 'Дерево файлов' \
      --create 'Команды генератора файлов' \
      --help 'Справка'
}
show() {
case "$1" in
 --basic) cat <<'EOF'
=== ОСНОВЫ ===
i         Ввод текста       Esc       NORMAL
:w        Сохранить         :wq       Сохранить и выйти
:q        Закрыть окно      :q!       Выйти без сохранения
u         Отменить          Ctrl+r    Повторить
EOF
;;
 --edit) cat <<'EOF'
=== РЕДАКТИРОВАНИЕ ===
v / V          Выделение символов / строк
d / y / p      Вырезать / копировать / вставить
ciw / diw      Изменить / удалить слово
Space k        Строку вверх
Space j        Строку вниз
Space k/j      Переместить выделенные строки
Ctrl+s         Сохранить; форматировать C# при наличии Roslyn
EOF
;;
 --search) cat <<'EOF'
=== ПОИСК ===
Space ff       Файлы
Space fg       Текст проекта
Space fb       Буферы
Space fs       Символы текущего файла
/слово         Поиск в файле; n/N — далее/назад
EOF
;;
 --csharp) cat <<'EOF'
=== C# ===
gd / gr         Определение / ссылки
K               Описание символа
Space rn        Переименовать
Space ca        Code action
Space d         Диагностика
Ctrl+Space      Подсказки в INSERT
Ctrl+k         Параметры метода
Ctrl+l         Другая перегрузка
EOF
;;
 --window) cat <<'EOF'
=== ОКНА ===
]b / [b         Следующий / предыдущий буфер
Space bd        Удалить текущий буфер
Ctrl+w h/j/k/l   Перемещение между окнами
:split/:vsplit  Разделить окно
EOF
;;
 --terminal) cat <<'EOF'
=== ТЕРМИНАЛ ===
Space tt       Показать/скрыть постоянный терминал
Esc Esc        Перейти в NORMAL из терминала
exit           Завершить оболочку
EOF
;;
 --tree) cat <<'EOF'
=== ДЕРЕВО ФАЙЛОВ ===
Space e        Открыть/закрыть дерево
a              Создать файл/каталог
r              Переименовать
d              Удалить
Enter          Открыть файл
g?             Все команды дерева
EOF
;;
 --create) cat <<'EOF'
=== ГЕНЕРАТОРЫ C++ / C# / DevOps ===
:CreateCpp -c -n Player -p Engine/
:CreateCpp -s -n Vector2 -p Math/
:CreateCpp -e -n State
:CreateCpp -i -n IRenderer
:CreateCpp --header -n Common
:CreateCpp --source -n Helpers
:CreateCpp --test -n Player -p tests/
:CreateCpp -c -n Renderer -b -sp --subdir Graphics/
:CreateCSharp -c -n PhotoService -p Services/
:CreateCSharp -rs -n Point --readonly

:CreateDevOps -df -p .                 Dockerfile
:CreateDevOps -dc -p deploy/           compose.yaml
:CreateDevOps -di                     .dockerignore
:CreateDevOps -gi                     .gitignore
:CreateDevOps -gl                     .gitlab-ci.yml
:CreateDevOps -b -n backup -p scripts/
:CreateDevOps -ps -n deploy -p scripts/
:CreateDevOps -sd -n app -p deploy/systemd/
:CreateDevOps -ng -n reverse-proxy -p deploy/nginx/
:CreateDevOps --help
DevOps: один вызов — один файл, без запуска и chmod +x.
-n разрешён только для Bash, PowerShell, systemd и Nginx.
Язык генераторов: vim.g.devkit_language = "ru" / "en".

-n / --name NAME          Имя типа / файла
-p / --path DIR           Базовый каталог от корня запуска Neovim
-ho / --header-only       Только заголовок C++
-so / --source-only       Только исходник C++
-b / --both               Оба файла C++
-sp / --split             Раздельные каталоги include/ и src/
-tg / --together          Файлы рядом
--subdir DIR              Вложенный каталог при split
--test                    Один NAMETest.cpp с GoogleTest (без заголовка)
-s / --struct             Структура (для обеих основных команд)
--help                    Справка выбранного генератора
:GeneratorHelp            Разделы C++ / C# / DevOps встроенной справки
:GeneratorList            Команды генераторов и служебные команды
:CreateHelp               Полная текстовая справка
:CreateRoot               Проверить корень генератора
EOF
;;
 *) help; exit 2;;
esac
}
if [[ "${1:---help}" == "--help" || "${1:---help}" == '-h' ]]; then
 help
else
 show "$1"
fi
